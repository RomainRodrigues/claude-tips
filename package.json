{
  "name": "claude-tips",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "NITRO_PRESET=cloudflare-module nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "deploy": "pnpm build:cloudflare && wrangler deploy && pnpm db:seed",
    "db:seed": "node scripts/seed-d1.mjs && wrangler d1 execute DB --remote --file=.output/d1/docs.sql && wrangler d1 execute DB --remote --file=.output/d1/landing.sql"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@iconify-json/simple-icons": "^1.2.95",
    "@iconify-json/vscode-icons": "^1.2.77",
    "@nuxt/content": "^3.16.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/mcp-toolkit": "^0.21.0",
    "@nuxtjs/mdc": "^0.23.1",
    "@takumi-rs/core": "^2.13.7",
    "@vueuse/core": "^14.4.0",
    "agents": "^0.24.0",
    "minimark": "^0.2.0",
    "nuxt": "^4.5.2",
    "nuxt-llms": "0.2.0",
    "nuxt-og-image": "^6.7.8",
    "tailwindcss": "^4.3.3",
    "ufo": "^1.6.4",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@12.4.2"
}
