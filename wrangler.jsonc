{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-tips",
  "compatibility_date": "2024-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claude-tips-content",
      "database_id": "783c1a25-2f31-4173-a510-d50a1373afbb"
    }
  ],
  // Nécessite que la zone DNS de claude.romrd.fr soit gérée par Cloudflare.
  "routes": [{ "pattern": "claude.romrd.fr", "custom_domain": true }]
}
